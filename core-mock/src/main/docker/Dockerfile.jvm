FROM gradle:8.14.3-jdk21-alpine AS build
WORKDIR /src
COPY . .
RUN gradle :core-mock:quarkusBuild --no-daemon --no-parallel --max-workers=2
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/core-mock/build/quarkus-app/ ./
EXPOSE 8082
USER 1001
ENTRYPOINT ["java","-jar","quarkus-run.jar"]
